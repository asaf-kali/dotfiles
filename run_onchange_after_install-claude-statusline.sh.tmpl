#!/bin/bash
# Points Claude Code's statusLine at ~/.claude/statusline-command.sh (installed by
# chezmoi from dot_claude/executable_statusline-command.sh), on any machine where the
# `claude` CLI is present. Skips otherwise.
#
# run_onchange_: reruns on `chezmoi apply` whenever this rendered script changes. The
# hash below pulls the statusline script's own content into that hash, so editing it
# also re-triggers this — the two can't drift apart.
#
# statusline script hash (forces rerun on change): {{ include "dot_claude/executable_statusline-command.sh" | sha256sum }}
set -uo pipefail

if ! command -v claude >/dev/null 2>&1; then
    echo "== claude statusline: skipped (claude not installed) =="
    exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "== claude statusline: skipped (python3 not installed) =="
    exit 0
fi

mkdir -p "$HOME/.claude"
settings="$HOME/.claude/settings.json"
[ -f "$settings" ] || printf '{}' > "$settings"

python3 - "$settings" "bash $HOME/.claude/statusline-command.sh" <<'PY'
import json
import sys

path, command = sys.argv[1], sys.argv[2]

with open(path) as f:
    data = json.load(f)

data["statusLine"] = {"type": "command", "command": command}

with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
PY

echo "== claude statusline: configured =="
