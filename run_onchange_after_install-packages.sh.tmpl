#!/bin/bash
# Installs packages from .chezmoidata/packages.yaml.
# run_onchange_: reruns on `chezmoi apply` whenever rendered content changes.
#
# Sections are independent: a failure in one (or in a single package) is
# logged and does not stop the others. Exits non-zero if anything failed.
# Packages this machine can't provide (not in its apt repos, or no snap
# command) are warnings, not failures, so later run_ scripts still run.
set -uo pipefail

FAILURES=()
SKIPPED=()

install_apt() {
    echo "== apt =="
    sudo apt update || { FAILURES+=("apt update"); return; }
    # apt install is all-or-nothing, so one package missing from this
    # release's repos would block the rest: install only what apt can find.
    local available=()
    for pkg in{{ range .packages.apt }} {{ . }}{{ end }}; do
        if apt-cache show "$pkg" >/dev/null 2>&1; then
            available+=("$pkg")
        else
            SKIPPED+=("apt $pkg")
        fi
    done
    [ ${#available[@]} -gt 0 ] || return
    sudo apt install --yes "${available[@]}" || FAILURES+=("apt install")
}

install_snap() {
    echo "== snap =="
    command -v snap >/dev/null 2>&1 || { SKIPPED+=("snap (not installed)"); return; }
{{- range .packages.snap }}
    sudo snap install {{ .name }}{{ if index . "classic" }} --classic{{ end }} || FAILURES+=("snap {{ .name }}")
{{- end }}
}

install_uv() {
{{- if .packages.uv }}
    echo "== uv tools =="
    command -v uv >/dev/null 2>&1 || curl -LsSf https://astral.sh/uv/install.sh | sh || { FAILURES+=("uv install"); return; }
    # uv installs to ~/.local/bin, which may not be on PATH in this same run.
    export PATH="$HOME/.local/bin:$PATH"
{{- range .packages.uv }}
    uv tool install {{ . }} || FAILURES+=("uv {{ . }}")
{{- end }}
{{- else }}
    :  # no uv tools configured
{{- end }}
}

install_apt
install_snap
install_uv

if [ ${#SKIPPED[@]} -gt 0 ]; then
    echo "== SKIPPED (unavailable here): ${SKIPPED[*]} =="
fi
if [ ${#FAILURES[@]} -gt 0 ]; then
    echo "== FAILED: ${FAILURES[*]} =="
    exit 1
fi
echo "== packages done =="
